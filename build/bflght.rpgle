**FREE
// -----------------------------------------------------------------
// Program: BFLGHT
// Description: Build flight schedule from city tables
// -----------------------------------------------------------------

CTL-OPT DFTACTGRP(*NO) ACTGRP(*NEW) BNDDIR('FUTIL');

// File declarations
DCL-F FRCITY DISK(*EXT) KEYED USAGE(*INPUT);
DCL-F TOCITY DISK(*EXT) KEYED USAGE(*INPUT);
DCL-F FLIGHTS DISK(228) USAGE(*OUTPUT);

// Compile-time arrays for arrival times
DCL-S A_TABA1# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA1D CHAR(32) DIM(9) ALT(A_TABA1#);
DCL-S A_TABA2# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA2D CHAR(32) DIM(9) ALT(A_TABA2#);
DCL-S A_TABA3# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA3D CHAR(32) DIM(9) ALT(A_TABA3#);
DCL-S A_TABA4# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA4D CHAR(32) DIM(9) ALT(A_TABA4#);
DCL-S A_TABA5# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA5D CHAR(32) DIM(9) ALT(A_TABA5#);
DCL-S A_TABA6# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA6D CHAR(32) DIM(9) ALT(A_TABA6#);
DCL-S A_TABA7# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA7D CHAR(32) DIM(9) ALT(A_TABA7#);
DCL-S A_TABA8# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA8D CHAR(32) DIM(9) ALT(A_TABA8#);
DCL-S A_TABA9# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABA9D CHAR(32) DIM(9) ALT(A_TABA9#);

// Compile-time arrays for departure times
DCL-S A_TABD1# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD1D CHAR(32) DIM(9) ALT(A_TABD1#);
DCL-S A_TABD2# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD2D CHAR(32) DIM(9) ALT(A_TABD2#);
DCL-S A_TABD3# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD3D CHAR(32) DIM(9) ALT(A_TABD3#);
DCL-S A_TABD4# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD4D CHAR(32) DIM(9) ALT(A_TABD4#);
DCL-S A_TABD5# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD5D CHAR(32) DIM(9) ALT(A_TABD5#);
DCL-S A_TABD6# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD6D CHAR(32) DIM(9) ALT(A_TABD6#);
DCL-S A_TABD7# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD7D CHAR(32) DIM(9) ALT(A_TABD7#);
DCL-S A_TABD8# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD8D CHAR(32) DIM(9) ALT(A_TABD8#);
DCL-S A_TABD9# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABD9D CHAR(32) DIM(9) ALT(A_TABD9#);

// Compile-time array for days of the week
DCL-S A_TABDY# ZONED(1:0) DIM(7) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABDYD CHAR(16) DIM(7) ALT(A_TABDY#);

// Compile-time array for ticket prices
DCL-S A_TABTP# ZONED(1:0) DIM(9) CTDATA PERRCD(1) ASCEND;
DCL-S A_TABTPD CHAR(22) DIM(9) ALT(A_TABTP#);

// Data structure for flight record output
DCL-DS FLTREC LEN(228);
  FLGHTN BINDEC(9:0) POS(1);
  DEPINT CHAR(18) POS(5);
  FLDL03 BINDEC(4:0) POS(5) INZ(3);
  DEPI16 CHAR(16) POS(7);
  DEPCTY CHAR(18) POS(23);
  DEPCLN BINDEC(4:0) POS(23) INZ(0);
  DEPC16 CHAR(16) POS(25);
  DAYOWK CHAR(18) POS(41);
  DAYOLN BINDEC(4:0) POS(41) INZ(0);
  DAYO16 CHAR(16) POS(43);
  ARRINT CHAR(18) POS(59);
  FLDL01 BINDEC(4:0) POS(59) INZ(3);
  ARRI16 CHAR(16) POS(61);
  ARRCTY CHAR(18) POS(77);
  ARRCLN BINDEC(4:0) POS(77) INZ(0);
  ARRC16 CHAR(16) POS(79);
  DEPTIM CHAR(34) POS(95);
  FLDL08 BINDEC(4:0) POS(95) INZ(8);
  DEPT32 CHAR(32) POS(97);
  ARRTIM CHAR(34) POS(129);
  FLDL07 BINDEC(4:0) POS(129) INZ(8);
  ARRT32 CHAR(32) POS(131);
  AIRLIN CHAR(34) POS(163);
  FLDL05 BINDEC(4:0) POS(163) INZ(3);
  AIRL32 CHAR(32) POS(165);
  SEATS# BINDEC(9:0) POS(197);
  TICKTS CHAR(24) POS(201);
  FLDL09 BINDEC(4:0) POS(201) INZ(3);
  TICK22 CHAR(22) POS(203);
  MILES# BINDEC(9:0) POS(225);
END-DS;

// Flight key formatting data structure
DCL-DS FLGHTA;
  WEEKA CHAR(1) POS(1);
  TIMEA CHAR(1) POS(2);
  COUNTA CHAR(5) POS(3);
END-DS;

// Constants
DCL-C @RESET '                ';
DCL-C @OFF '0';
DCL-C @ON '1';

// Standalone work variables
DCL-S FCOUNT PACKED(5:0) INZ(1);
DCL-S BGNNBR PACKED(6:0);
DCL-S ENDNBR PACKED(6:0);
DCL-S RNDVAL PACKED(6:0);
DCL-S RTVNUM PACKED(1:0);
DCL-S WEEKCT PACKED(1:0);
DCL-S TIMECT PACKED(1:0);
DCL-S idx INT(10);

/COPY 'reservations/protypes.rpgleinc'

// Main logic
FCOUNT = 1;

READ FRCITY;
DOW NOT %EOF(FRCITY);
  SEATS# = 250;
  MILES# = 1250;

  AIRL32 = FRCALN;
  DEPI16 = FRCINT;
  DEPCLN = %CHECKR(' ' : FRCNAM);
  DEPC16 = FRCNAM;

  SETLL @RESET TOCITY;

  READ TOCITY;
  DOW NOT %EOF(TOCITY);
    IF TOCNAM <> FRCNAM;
      ARRCLN = %CHECKR(' ' : TOCNAM);
      ARRC16 = TOCNAM;
      ARRI16 = TOCINT;

      BGNNBR = 1;
      ENDNBR = 9;
      RNDVAL = 0;
      RNDVAL = getRandomNumber(BGNNBR : ENDNBR : RNDVAL);

      RTVNUM = RNDVAL;

      FOR WEEKCT = 1 TO 7;
        idx = %LOOKUP(WEEKCT : A_TABDY#);
        IF idx > 0;
          DAYO16 = A_TABDYD(idx);
          DAYOLN = %CHECKR(' ' : A_TABDYD(idx));
        ENDIF;

        FOR TIMECT = 1 TO 9;
          idx = %LOOKUP(TIMECT : A_TABTP#);
          IF idx > 0;
            TICK22 = A_TABTPD(idx);
          ENDIF;

          ARRT32 = *BLANKS;
          DEPT32 = *BLANKS;

          SELECT;
            WHEN TIMECT = 1;
              idx = %LOOKUP(RTVNUM : A_TABA1#);
              IF idx > 0;
                ARRT32 = A_TABA1D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD1#);
              IF idx > 0;
                DEPT32 = A_TABD1D(idx);
              ENDIF;
            WHEN TIMECT = 2;
              idx = %LOOKUP(RTVNUM : A_TABA2#);
              IF idx > 0;
                ARRT32 = A_TABA2D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD2#);
              IF idx > 0;
                DEPT32 = A_TABD2D(idx);
              ENDIF;
            WHEN TIMECT = 3;
              idx = %LOOKUP(RTVNUM : A_TABA3#);
              IF idx > 0;
                ARRT32 = A_TABA3D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD3#);
              IF idx > 0;
                DEPT32 = A_TABD3D(idx);
              ENDIF;
            WHEN TIMECT = 4;
              idx = %LOOKUP(RTVNUM : A_TABA4#);
              IF idx > 0;
                ARRT32 = A_TABA4D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD4#);
              IF idx > 0;
                DEPT32 = A_TABD4D(idx);
              ENDIF;
            WHEN TIMECT = 5;
              idx = %LOOKUP(RTVNUM : A_TABA5#);
              IF idx > 0;
                ARRT32 = A_TABA5D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD5#);
              IF idx > 0;
                DEPT32 = A_TABD5D(idx);
              ENDIF;
            WHEN TIMECT = 6;
              idx = %LOOKUP(RTVNUM : A_TABA6#);
              IF idx > 0;
                ARRT32 = A_TABA6D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD6#);
              IF idx > 0;
                DEPT32 = A_TABD6D(idx);
              ENDIF;
            WHEN TIMECT = 7;
              idx = %LOOKUP(RTVNUM : A_TABA7#);
              IF idx > 0;
                ARRT32 = A_TABA7D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD7#);
              IF idx > 0;
                DEPT32 = A_TABD7D(idx);
              ENDIF;
            WHEN TIMECT = 8;
              idx = %LOOKUP(RTVNUM : A_TABA8#);
              IF idx > 0;
                ARRT32 = A_TABA8D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD8#);
              IF idx > 0;
                DEPT32 = A_TABD8D(idx);
              ENDIF;
            WHEN TIMECT = 9;
              idx = %LOOKUP(RTVNUM : A_TABA9#);
              IF idx > 0;
                ARRT32 = A_TABA9D(idx);
              ENDIF;
              idx = %LOOKUP(RTVNUM : A_TABD9#);
              IF idx > 0;
                DEPT32 = A_TABD9D(idx);
              ENDIF;
          ENDSL;

          WEEKA = %CHAR(WEEKCT);
          TIMEA = %CHAR(TIMECT);
          COUNTA = %EDITC(FCOUNT : 'X');
          FLGHTN = %DEC(FLGHTA : 7 : 0);

          WRITE FLIGHTS FLTREC;

          FCOUNT += 1;
        ENDFOR;
      ENDFOR;
    ENDIF;

    READ TOCITY;
  ENDDO;

  READ FRCITY;
ENDDO;

*INLR = *ON;

