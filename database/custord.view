-- Join File with Customers/Orders by Customer Name
CREATE OR REPLACE VIEW CUSTORD (
    ORDRNO,
    AGNTNO,
    CUSTNM,
    CUSTNO,
    FLGTNO,
    DEPART,
    TCKTNO,
    CLASS,
    SENDSG
) AS
SELECT
    O.ORDER_NUMBER,
    O.AGENT_NO,
    C.CUSTOMER_NAME,
    C.CUSTOMER_NO,
    O.FLIGHT_NUMBER,
    O.DEPARTURE_DATE,
    O.TICKETS_ORDERED,
    O.CLASS,
    O.SEND_SIGNATURE_WITH_ORDER
FROM CUSTOMERS C
    JOIN ORDERS O ON C.CUSTOMER_NO = O.CUSTOMER_NO
RCDFMT CUSNMR;
