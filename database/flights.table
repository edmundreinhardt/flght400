-- Flight schedule
CREATE OR REPLACE TABLE FLIGHTS (
    FLIGHT_NUMBER       INTEGER         NOT NULL,
    DEPARTURE_INITIALS  VARCHAR(16)     CCSID 37,
    DEPARTURE           VARCHAR(16)     CCSID 37,
    DAY_OF_WEEK         VARCHAR(16)     CCSID 37,
    ARRIVAL_INITIALS    VARCHAR(16)     CCSID 37,
    ARRIVAL             VARCHAR(16)     CCSID 37,
    DEPARTURE_TIME      VARCHAR(32)     CCSID 37,
    ARRIVAL_TIME        VARCHAR(32)     CCSID 37,
    AIRLINES            VARCHAR(32)     CCSID 37,
    SEATS_AVAILABLE     INTEGER,
    TICKET_PRICE        VARCHAR(22)     CCSID 37,
    MILEAGE             INTEGER,
    CONSTRAINT FLIGHTS_PK PRIMARY KEY (FLIGHT_NUMBER)
) RCDFMT FLIGHTS;
