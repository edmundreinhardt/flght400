-- Join File with Orders/Customers by Date
CREATE OR REPLACE VIEW ORDDATE (
    AGNTNO,
    CUSTNM,
    CUSTNO,
    FLGTNO,
    DEPART,
    ORDRNO,
    TCKTNO,
    CLASS,
    SENDSG
) AS
SELECT
    O.AGENT_NO,
    C.CUSTOMER_NAME,
    O.CUSTOMER_NO,
    O.FLIGHT_NUMBER,
    O.DEPARTURE_DATE,
    O.ORDER_NUMBER,
    O.TICKETS_ORDERED,
    O.CLASS,
    O.SEND_SIGNATURE_WITH_ORDER
FROM ORDERS O
    JOIN CUSTOMERS C ON O.CUSTOMER_NO = C.CUSTOMER_NO
RCDFMT ORDDTR;
