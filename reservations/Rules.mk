# Layer 7a -- Reservation Transaction Programs
# Understand: BOUND_SRVPGM -> FUTIL (FRS001, FRS002 confirmed)

# FRS000 -- Logon / main dispatcher
FRS000.PGM: frs000.rpgle FRS000DF.FILE

# FRS001 -- New Order (15 outbound deps; binds FUTIL)
# Understand FILE_OPEN: ORDERS FLIGHTSZ FRCITY TOCITY FNEXTO CUSTNAME CUSTOMER
# Understand PGM_CALL: FRS402 FRS403 FRS404 FRS405 FRS406 + FUTIL (getDayOfWeek)
FRS001.PGM: frs001.rpgle \
    FRS001DF.FILE \
    ORDERS.FILE FLIGHTSZ.FILE \
    FRCITY.FILE TOCITY.FILE FNEXTO.FILE \
    CUSTNAME.FILE CUSTOMER.FILE \
    FRS402.PGM FRS403.PGM \
    FRS404.PGM FRS405.PGM FRS406.PGM \
    FUTIL.SRVPGM

# FRS001T -- New Order teaching/trace variant
FRS001T.PGM: frs001t.rpgle \
    FRS001DF.FILE \
    ORDERS.FILE FLIGHTSZ.FILE \
    FRCITY.FILE TOCITY.FILE FNEXTO.FILE \
    CUSTNAME.FILE CUSTOMER.FILE \
    FRS402.PGM FRS403.PGM \
    FRS404.PGM FRS405.PGM FRS406.PGM \
    FUTIL.SRVPGM

# FRS001U -- New Order update variant
FRS001U.PGM: frs001u.rpgle \
    FRS001DF.FILE \
    ORDERS.FILE FLIGHTSZ.FILE \
    FRCITY.FILE TOCITY.FILE FNEXTO.FILE \
    CUSTNAME.FILE CUSTOMER.FILE \
    FRS402.PGM FRS403.PGM \
    FRS404.PGM FRS405.PGM FRS406.PGM \
    FUTIL.SRVPGM

# FRS001U2 -- New Order variant 2
FRS001U2.PGM: frs001u2.rpgle \
    FRS001DF.FILE \
    ORDERS.FILE FLIGHTSZ.FILE \
    FRCITY.FILE TOCITY.FILE FNEXTO.FILE \
    CUSTNAME.FILE CUSTOMER.FILE \
    FRS402.PGM FRS403.PGM \
    FRS404.PGM FRS405.PGM FRS406.PGM \
    FUTIL.SRVPGM

# FRS001X -- Experimental variant
FRS001X.PGM: frs001x.rpgle \
    FRS001DF.FILE \
    ORDERS.FILE FLIGHTSZ.FILE \
    FRCITY.FILE TOCITY.FILE FNEXTO.FILE \
    FUTIL.SRVPGM

# FRS009 -- Select Order (calls FRS407 FRS408; must precede FRS002/FRS003)
# Understand FILE_OPEN: ORDDATE ORDNAME CUSTOMERS
FRS009.PGM: frs009.rpgle \
    FRS009DF.FILE \
    ORDDATE.FILE ORDNAME.FILE \
    FRS407.PGM FRS408.PGM

# FRS002 -- Update Order (binds FUTIL; calls FRS009 FRS409)
# Understand FILE_OPEN: ORDERS ORDERSZ FLIGHTSZ FRCITY TOCITY
FRS002.PGM: frs002.rpgle \
    FRS002DF.FILE \
    ORDERS.FILE ORDERSZ.FILE \
    FLIGHTSZ.FILE FRCITY.FILE TOCITY.FILE \
    FRS009.PGM FRS409.PGM \
    FUTIL.SRVPGM

# FRS003 -- Display Order (calls FRS009)
# Understand FILE_OPEN: ORDERS FLIGHTS
FRS003.PGM: frs003.rpgle \
    FRS003DF.FILE \
    ORDERS.FILE FLIGHTS.FILE \
    FRS009.PGM

# FRS004 -- Delete Order (calls FRS409 FRS410)
FRS004.PGM: frs004.rpgle \
    FRS004DF.FILE \
    ORDERS.FILE \
    FRS409.PGM FRS410.PGM

# FRS005 -- FAX Order (calls FRS411)
FRS005.PGM: frs005.rpgle \
    FRS005DF.FILE \
    ORDERS.FILE \
    FRS411.PGM
