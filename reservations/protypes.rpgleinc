**FREE
// -----------------------------------------------------------------
// PROTYPES.RPGLEINC - Shared program call prototypes
// Used by all FRS programs
// -----------------------------------------------------------------
// IBM system APIs
// -----------------------------------------------------------------
DCL-PR QMHRMVPM EXTPGM('QMHRMVPM');
  MsgQ        CHAR(10);
  MsgQCtr     BINDEC(9:0);
  MsgKey      CHAR(4);
  RmvClr      CHAR(10);
  ApiErr      CHAR(256) OPTIONS(*VARSIZE);
END-PR;

DCL-PR QMHSNDPM EXTPGM('QMHSNDPM');
  MsgId       CHAR(7);
  MsgF        CHAR(20);
  MsgDta      CHAR(80);
  MsgDtaLen   BINDEC(9:0);
  MsgTyp      CHAR(10);
  MsgQ        CHAR(10);
  MsgQCtr     BINDEC(9:0);
  MsgKey      CHAR(4);
  ApiErr      CHAR(256) OPTIONS(*VARSIZE);
END-PR;

DCL-PR QCMDEXC EXTPGM('QCMDEXC');
  Cmd         CHAR(32702) OPTIONS(*VARSIZE);
  CmdLen      PACKED(15:5);
END-PR;

DCL-PR QUSCMDLN EXTPGM('QUSCMDLN');
END-PR;

DCL-PR QWCCVTDT EXTPGM('QWCCVTDT');
  FmtIn       CHAR(10);
  DtIn        CHAR(16);
  FmtOut      CHAR(10);
  DtOut       CHAR(16);
  ApiErr      CHAR(256) OPTIONS(*VARSIZE);
END-PR;

// -----------------------------------------------------------------
// Application utility procedures (FUTIL service program)
// -----------------------------------------------------------------
DCL-PR gregorianToJulian PACKED(5:0) EXTPROC('gregorianToJulian');
  inMonth       PACKED(2:0) CONST;
  inDay         PACKED(2:0) CONST;
  inYear        PACKED(4:0) CONST;
  outJulianDay  PACKED(5:0) OPTIONS(*NOPASS);
END-PR;

DCL-PR julianToGregorian EXTPROC('julianToGregorian');
  inJulianDay   PACKED(5:0) CONST;
  outMonth      PACKED(2:0);
  outDay        PACKED(2:0);
  outYear       PACKED(4:0);
END-PR;

DCL-PR getDayOfWeek CHAR(16) EXTPROC('getDayOfWeek');
  inMonth       PACKED(2:0) CONST;
  inDay         PACKED(2:0) CONST;
  inYear        PACKED(4:0) CONST;
  outDayOfWeek  CHAR(16) OPTIONS(*NOPASS);
END-PR;

DCL-PR getRandomNumber PACKED(6:0) EXTPROC('getRandomNumber');
  inBeginNumber   PACKED(6:0) CONST OPTIONS(*NOPASS);
  inEndNumber     PACKED(6:0) CONST OPTIONS(*NOPASS);
  outRandomNumber PACKED(6:0) OPTIONS(*NOPASS);
END-PR;

DCL-PR initializeRandomSeed EXTPROC('initializeRandomSeed');
  Seed  PACKED(9:9);
END-PR;

