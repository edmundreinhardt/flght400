      *-----------------------------------------------------------------
      * PROTYPES.RPGLE - Shared program call prototypes
      * Used by all FRS programs
      *-----------------------------------------------------------------
      * IBM system APIs
      *-----------------------------------------------------------------
     D QMHRMVPM        PR                  EXTPGM('QMHRMVPM')
     D  MsgQ                         10A
     D  MsgQCtr                       9B 0
     D  MsgKey                        4A
     D  RmvClr                       10A
     D  ApiErr                      256A   OPTIONS(*VARSIZE)
      *
     D QMHSNDPM        PR                  EXTPGM('QMHSNDPM')
     D  MsgId                         7A
     D  MsgF                         20A
     D  MsgDta                       80A
     D  MsgDtaLen                     9B 0
     D  MsgTyp                       10A
     D  MsgQ                         10A
     D  MsgQCtr                       9B 0
     D  MsgKey                        4A
     D  ApiErr                      256A   OPTIONS(*VARSIZE)
      *
     D QCMDEXC         PR                  EXTPGM('QCMDEXC')
     D  Cmd                       32702A   OPTIONS(*VARSIZE)
     D  CmdLen                       15P 5
      *
     D QUSCMDLN        PR                  EXTPGM('QUSCMDLN')
      *
     D QWCCVTDT        PR                  EXTPGM('QWCCVTDT')
     D  FmtIn                        10A
     D  DtIn                         16A
     D  FmtOut                       10A
     D  DtOut                        16A
     D  ApiErr                      256A   OPTIONS(*VARSIZE)
      *-----------------------------------------------------------------
      * Application utility procedures (FUTIL service program)
      *-----------------------------------------------------------------
     D gregorianToJulian...
     D                 PR             5P 0 EXTPROC('gregorianToJulian')
     D  inMonth                       2P 0 CONST
     D  inDay                         2P 0 CONST
     D  inYear                        4P 0 CONST
     D  outJulianDay                  5P 0 OPTIONS(*NOPASS)
      *
     D julianToGregorian...
     D                 PR                  EXTPROC('julianToGregorian')
     D  inJulianDay                   5P 0 CONST
     D  outMonth                      2P 0
     D  outDay                        2P 0
     D  outYear                       4P 0
      *
     D getDayOfWeek    PR            16A   EXTPROC('getDayOfWeek')
     D  inMonth                       2P 0 CONST
     D  inDay                         2P 0 CONST
     D  inYear                        4P 0 CONST
     D  outDayOfWeek                 16A   OPTIONS(*NOPASS)
      *
     D getRandomNumber...
     D                 PR             6P 0 EXTPROC('getRandomNumber')
     D  inBeginNumber                 6P 0 CONST OPTIONS(*NOPASS)
     D  inEndNumber                   6P 0 CONST OPTIONS(*NOPASS)
     D  outRandomNumber...
     D                                6P 0 OPTIONS(*NOPASS)
      *
     D initializeRandomSeed...
     D                 PR                  EXTPROC('initializeRandomSeed')
     D  Seed                          9P 9
